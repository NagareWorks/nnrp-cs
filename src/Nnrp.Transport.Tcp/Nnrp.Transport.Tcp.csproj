      Condition="Exists('$(NnrpTcpTransportArtifactRoot)\android-arm\libnnrp_ffi.so')" />
    <None Include="$(NnrpTcpTransportArtifactRoot)\android-arm64\libnnrp_ffi.so"
      Pack="true"
      PackagePath="runtimes/android-arm64/native/nnrp/transport/tcp/"
      Visible="false"
      Condition="Exists('$(NnrpTcpTransportArtifactRoot)\android-arm64\libnnrp_ffi.so')" />
    <None Include="$(NnrpTcpTransportArtifactRoot)\ios-arm64\libnnrp_ffi.a"
      Pack="true"
      PackagePath="runtimes/ios-arm64/native/nnrp/transport/tcp/"
      Visible="false"
      Condition="Exists('$(NnrpTcpTransportArtifactRoot)\ios-arm64\libnnrp_ffi.a')" />
    <None Include="$(NnrpTcpTransportArtifactRoot)\iossimulator-x64\libnnrp_ffi.a"
      Pack="true"
      PackagePath="runtimes/iossimulator-x64/native/nnrp/transport/tcp/"
      Visible="false"
      Condition="Exists('$(NnrpTcpTransportArtifactRoot)\iossimulator-x64\libnnrp_ffi.a')" />
