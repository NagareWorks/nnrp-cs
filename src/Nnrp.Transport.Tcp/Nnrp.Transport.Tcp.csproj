      Pack="true"
      PackagePath="runtimes/iossimulator-arm64/native/nnrp/transport/tcp/"
      Visible="false"
      Condition="Exists('$(NnrpTcpTransportArtifactRoot)\iossimulator-arm64\libnnrp_ffi.a')" />
  </ItemGroup>

</Project>
